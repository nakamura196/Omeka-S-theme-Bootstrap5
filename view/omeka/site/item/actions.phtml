</div>

<script>
// ページ読み込み時に利用者のローカルタイムゾーンで日付を設定
document.addEventListener('DOMContentLoaded', function() {
    const now = new Date();
    
    // APA用（年のみ）
    document.querySelectorAll('.citation-year').forEach(el => {
        el.textContent = now.getFullYear();
    });
    
    // MLA用（日 月名 年）
    const monthsShort = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    document.querySelectorAll('.citation-date-mla').forEach(el => {
        el.textContent = now.getDate() + ' ' + monthsShort[now.getMonth()] + ' ' + now.getFullYear();
    });
    
    // Chicago用（月名 日, 年）
    const monthsFull = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
    document.querySelectorAll('.citation-date-chicago').forEach(el => {
        el.textContent = monthsFull[now.getMonth()] + ' ' + now.getDate() + ', ' + now.getFullYear();
    });
});

/**
 * URLをクリップボードにコピー
 */
function copyToClipboard(url) {
    navigator.clipboard.writeText(url).then(function() {
        showToast('<?= $translate('URL copied to clipboard') ?>');
    }).catch(function(err) {
        console.error('Copy failed: ', err);
        fallbackCopyTextToClipboard(url);
    });
}

/**
 * 引用テキストをコピー
 */
function copyCitationText(elementId) {
    const element = document.getElementById(elementId);
    const text = element.textContent || element.innerText;
    
    navigator.clipboard.writeText(text).then(function() {
        showToast('<?= $translate('Citation copied to clipboard') ?>');
    }).catch(function(err) {
        console.error('Copy failed: ', err);
        fallbackCopyTextToClipboard(text);
    });
}

/**
 * フォールバック: 古いブラウザ用のコピー機能
 */
function fallbackCopyTextToClipboard(text) {
    const textArea = document.createElement("textarea");
    textArea.value = text;
    textArea.style.position = "fixed";
    textArea.style.opacity = "0";
    document.body.appendChild(textArea);
    textArea.focus();
    textArea.select();
    
    try {
        document.execCommand('copy');
        showToast('<?= $translate('Copied to clipboard') ?>');
    } catch (err) {
        console.error('Fallback copy failed: ', err);
    }
    
    document.body.removeChild(textArea);
}

/**
 * Toast通知を表示
 */
function showToast(message) {
    const toastEl = document.getElementById('copyToast');
    const toastMessage = document.getElementById('toastMessage');
    toastMessage.textContent = message;
    
    const toast = new bootstrap.Toast(toastEl, {
        delay: 2000
    });
    toast.show();
}
</script>

