                                        <?= $escape($translate('Your browser does not support the audio tag.')) ?>
                                    </audio>
                                </div>
                            <?php elseif ($mediaType === 'application/pdf'): ?>
                                <!-- PDFの表示 -->
                                <div class="pdf-viewer">
