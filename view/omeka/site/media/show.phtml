                            <?php elseif (strpos($mediaType, 'video/') === 0): ?>
                                <!-- ビデオの表示 -->
                                <div class="video-viewer">
                                    <video controls class="w-100">
                                        <source src="<?= $escape($media->originalUrl()) ?>" 
                                                type="<?= $escape($mediaType) ?>">
                                        <?= $escape($translate('Your browser does not support the video tag.')) ?>
                                    </video>
                                </div>
                            <?php elseif (strpos($mediaType, 'audio/') === 0): ?>
