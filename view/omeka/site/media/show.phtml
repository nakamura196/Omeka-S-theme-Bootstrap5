<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$item = $media->item();
$this->headLink()->appendStylesheet($this->assetUrl('css/resource-page-blocks.css', 'Omeka'));
$this->htmlElement('body')->appendAttribute('class', 'media resource show');
$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;
?>
<div class="container mb-5">
    <header class="resource-header">
        <span class="eyebrow"><?php echo $escape($translate('Media')); ?></span>
        <?php echo $this->pageTitle($media->displayTitle(null, $valueLang), 2); ?>
        <p class="media-parent-item mt-2 mb-0">
            <i class="fa-solid fa-arrow-turn-up fa-flip-horizontal text-body-secondary me-1" aria-hidden="true"></i>
            <?php echo sprintf($escape($translate('Part of %s')), $item->link($item->displayTitle(null, $valueLang))); ?>
        </p>
    </header>

    <?php $this->trigger('view.show.before'); ?>
    <?php echo $this->resourcePageBlocks($media)->getBlocks(); ?>
    <?php $this->trigger('view.show.after'); ?>
</div>
