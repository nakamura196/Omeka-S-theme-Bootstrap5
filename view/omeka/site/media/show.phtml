                            </dd>

                            <?php if ($media->size()): ?>
                            <dt class="col-5"><?= $escape($translate('File size')) ?></dt>
                            <dd class="col-7">
                                <?php
                                $size = $media->size();
                                if ($size < 1024) {
                                    echo $size . ' B';
                                } elseif ($size < 1048576) {
                                    echo round($size / 1024, 2) . ' KB';
                                } else {
                                    echo round($size / 1048576, 2) . ' MB';
                                }
                                ?>
                            </dd>
                            <?php endif; ?>

