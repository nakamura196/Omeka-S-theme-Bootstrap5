<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');

$labelInfo = $this->fallbackSetting('property_label_information', ['site', 'global'], 'none');
$showLocale = (bool) $this->fallbackSetting('show_locale_label', ['site'], true);
$filterLocale = (bool) $this->fallbackSetting('filter_locale_values', ['site'], false);
$showValueAnnotations = (bool) $this->fallbackSetting('show_value_annotations', ['site'], true);
$lang = $this->lang();

$filterLocaleCallback = function ($value) use ($lang) {
    $valueLang = $value->lang();
    return $valueLang == '' || strcasecmp($valueLang, $lang) === 0;
};

// 言語コードを言語名に変換（多言語対応）
$languageNames = [
    'en' => $translate('English'),
    'ja' => $translate('Japanese'),
    'fr' => $translate('French'),
    'de' => $translate('German'),
    'es' => $translate('Spanish'),
    'it' => $translate('Italian'),
    'pt' => $translate('Portuguese'),
    'ru' => $translate('Russian'),
    'zh' => $translate('Chinese'),
    'ko' => $translate('Korean'),
    'ar' => $translate('Arabic'),
    'nl' => $translate('Dutch'),
    'sv' => $translate('Swedish'),
    'no' => $translate('Norwegian'),
    'da' => $translate('Danish'),
    'fi' => $translate('Finnish'),
    'pl' => $translate('Polish'),
    'tr' => $translate('Turkish'),
    'cs' => $translate('Czech'),
    'hu' => $translate('Hungarian'),
    'el' => $translate('Greek'),
    'he' => $translate('Hebrew'),
    'th' => $translate('Thai'),
    'vi' => $translate('Vietnamese'),
    'id' => $translate('Indonesian'),
    'ms' => $translate('Malay'),
    'hi' => $translate('Hindi'),
    'bn' => $translate('Bengali'),
    'uk' => $translate('Ukrainian'),
    'ro' => $translate('Romanian'),
];
?>

<?php if (count($values) > 0): ?>
<div class="metadata-section my-5">
    <div class="card">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="bi bi-tags me-2"></i><?= $translate('Properties') ?>
            </h5>
        </div>
        <div class="card-body">
            <?php
            foreach ($values as $term => $propertyData):
                $propertyValues = $propertyData['values'];
                if ($filterLocale) {
                    $propertyValues = array_filter($propertyValues, $filterLocaleCallback);
                }
                if (!$propertyValues) {
                    continue;
                }
                $property = $propertyData['property'];
                $propertyLabel = $propertyData['alternate_label'] ?: $translate($property->label());
            ?>
            <div class="property-item mb-4">
                <div class="row">
                    <div class="col-md-3">
                        <div class="property-label text-muted small fw-semibold">
                            <?php echo $escape($propertyLabel); ?>
                            <?php if ($labelInfo !== 'none' && $property): ?>
                                <?php if ($labelInfo === 'term'): ?>
                                    <div class="text-muted small mt-1">
                                        <code><?php echo $escape($property->term()); ?></code>
                                    </div>
                                <?php elseif ($labelInfo === 'vocab'): ?>
                                    <div class="text-muted small mt-1">
                                        <?php echo $escape($property->vocabulary()->label()); ?>
                                    </div>
                                <?php endif; ?>
                            <?php endif; ?>
                        </div>
                    </div>
                    <div class="col-md-9">
                        <?php foreach ($propertyValues as $index => $value): ?>
                        <?php
                        $valueType = $value->type();
                        $valueLang = $value->lang();
                        $valueAnnotation = $value->valueAnnotation();
                        ?>
                        <div class="property-value <?= $index > 0 ? 'mt-3' : '' ?>" lang="<?php echo $escape($valueLang); ?>">
                            <?php if ($showLocale && $valueLang): ?>
                            <?php
                            // 言語コードに対応する名前があれば使用、なければコードをそのまま表示
                            $languageDisplay = isset($languageNames[$valueLang]) ? $languageNames[$valueLang] : strtoupper($valueLang);
                            ?>
                            <span class="badge bg-info text-white me-2 mb-1" title="<?php echo $escape($valueLang); ?>">
                                <i class="bi bi-translate me-1"></i><?php echo $escape($languageDisplay); ?>
                            </span>
                            <?php endif; ?>
                            
                            <div class="value-content">
                                <?php if ('resource' == $valueType || strpos($valueType, 'resource') !== false): ?>
                                <?php 
                                $linkedResource = $value->valueResource();
                                $resourceClass = $linkedResource->resourceClass();
                                $resourceType = $linkedResource->resourceName();
                                
                                // サムネイル画像の取得を試みる
                                $thumbnailUrl = null;
                                if ($resourceType === 'items' && method_exists($linkedResource, 'primaryMedia')) {
                                    $primaryMedia = $linkedResource->primaryMedia();
                                    if ($primaryMedia && $primaryMedia->hasThumbnails()) {
                                        $thumbnailUrl = $primaryMedia->thumbnailUrl('square');
                                    }
                                } elseif ($resourceType === 'media' && $linkedResource->hasThumbnails()) {
                                    $thumbnailUrl = $linkedResource->thumbnailUrl('square');
                                } elseif (method_exists($linkedResource, 'thumbnail')) {
                                    $thumbnail = $linkedResource->thumbnail();
                                    if ($thumbnail) {
                                        $thumbnailUrl = $thumbnail->assetUrl();
                                    }
                                }
                                ?>
                                <div class="resource-link-card">
                                    <a href="<?= $escape($linkedResource->siteUrl()) ?>" class="text-decoration-none">
                                        <div class="d-flex align-items-center p-3 border rounded hover-effect">
                                            <?php if ($thumbnailUrl): ?>
                                            <div class="flex-shrink-0 me-3">
                                                <div class="thumbnail-wrapper">
                                                    <img src="<?= $escape($thumbnailUrl) ?>" 
                                                         alt="<?= $escape($linkedResource->displayTitle()) ?>" 
                                                         class="rounded shadow-sm"
                                                         style="width: 80px; height: 80px; object-fit: cover;">
                                                </div>
                                            </div>
                                            <?php else: ?>
                                            <div class="flex-shrink-0 me-3">
                                                <div class="icon-placeholder bg-light rounded d-flex align-items-center justify-content-center"
                                                     style="width: 80px; height: 80px;">
                                                    <?php if ($resourceType === 'items'): ?>
                                                        <i class="bi bi-file-earmark-text fs-3 text-muted"></i>
                                                    <?php elseif ($resourceType === 'item_sets'): ?>
                                                        <i class="bi bi-collection fs-3 text-muted"></i>
                                                    <?php elseif ($resourceType === 'media'): ?>
                                                        <i class="bi bi-file-image fs-3 text-muted"></i>
                                                    <?php else: ?>
                                                        <i class="bi bi-link-45deg fs-3 text-muted"></i>
                                                    <?php endif; ?>
                                                </div>
                                            </div>
                                            <?php endif; ?>
                                            
                                            <div class="flex-grow-1">
                                                <div class="d-flex align-items-start justify-content-between">
                                                    <div>
                                                        <h6 class="mb-1 text-dark resource-title">
                                                            <?= $escape($linkedResource->displayTitle()) ?>
                                                        </h6>
                                                        
                                                        <?php if ($resourceClass): ?>
                                                        <span class="badge bg-primary bg-opacity-10 text-primary me-2">
                                                            <i class="bi bi-tag me-1"></i><?= $escape($translate($resourceClass->label())) ?>
                                                        </span>
                                                        <?php endif; ?>
                                                        
                                                        <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                                            <?php if ($resourceType === 'items'): ?>
                                                                <i class="bi bi-file-earmark me-1"></i><?= $translate('Item') ?>
                                                            <?php elseif ($resourceType === 'item_sets'): ?>
                                                                <i class="bi bi-collection me-1"></i><?= $translate('Item Set') ?>
                                                            <?php elseif ($resourceType === 'media'): ?>
                                                                <i class="bi bi-image me-1"></i><?= $translate('Media') ?>
                                                            <?php endif; ?>
                                                        </span>
                                                        
                                                        <?php 
                                                        $description = $linkedResource->displayDescription();
                                                        if ($description): 
                                                        ?>
                                                        <p class="text-muted small mb-0 mt-2">
                                                            <?= $escape(mb_substr($description, 0, 150)) ?><?= mb_strlen($description) > 150 ? '...' : '' ?>
                                                        </p>
                                                        <?php endif; ?>
                                                    </div>
                                                    <div class="ms-2">
                                                        <i class="bi bi-box-arrow-up-right text-primary"></i>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                                <?php elseif ('uri' == $valueType): ?>
                                <a href="<?= $escape($value->uri()) ?>" target="_blank" class="text-decoration-none link-primary">
                                    <i class="bi bi-link-45deg me-1"></i>
                                    <?php echo $filterLocale ? $value->asHtml($lang) : $value->asHtml(); ?>
                                </a>
                                <?php else: ?>
                                <?php echo $filterLocale ? $value->asHtml($lang) : $value->asHtml(); ?>
                                <?php endif; ?>
                                
                                <?php if (!$value->isPublic()): ?>
                                <span class="badge bg-warning text-dark ms-2">
                                    <i class="bi bi-lock me-1"></i><?php echo $translate('Private'); ?>
                                </span>
                                <?php endif; ?>
                            </div>
                            
                            <?php if ($valueAnnotation && $showValueAnnotations): ?>
                            <div class="annotation-container mt-2">
                                <button class="btn btn-sm btn-outline-secondary" type="button" 
                                        data-bs-toggle="collapse" 
                                        data-bs-target="#annotation-<?php echo $property->id(); ?>-<?php echo $index; ?>" 
                                        aria-expanded="false">
                                    <i class="bi bi-chat-square-text me-1"></i>
                                    <?php echo $translate('Annotation'); ?>
                                </button>
                                <div class="collapse mt-2" id="annotation-<?php echo $property->id(); ?>-<?php echo $index; ?>">
                                    <div class="card card-body bg-light border-0">
                                        <?php echo $valueAnnotation->displayValues(); ?>
                                    </div>
                                </div>
                            </div>
                            <?php endif; ?>
                        </div>
                        <?php endforeach; ?>
                    </div>
                </div>
            </div>
            
            <?php if (next($values) !== false): ?>
            <hr class="my-3">
            <?php endif; ?>
            
            <?php endforeach; ?>
        </div>
    </div>
</div>

<style>
.resource-link-card .hover-effect {
    transition: all 0.3s ease;
    background-color: #fff;
}

.resource-link-card:hover .hover-effect {
    box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
    background-color: #f8f9fa;
}

.resource-link-card .resource-title {
    transition: color 0.3s ease;
}

.resource-link-card:hover .resource-title {
    color: #0d6efd !important;
}

.resource-link-card .thumbnail-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: 0.25rem;
}

.resource-link-card .icon-placeholder {
    border: 2px solid #dee2e6;
}

.property-value .resource-link-card {
    margin-bottom: 0.5rem;
}

.property-value .resource-link-card:last-child {
    margin-bottom: 0;
}
</style>
<?php endif; ?>