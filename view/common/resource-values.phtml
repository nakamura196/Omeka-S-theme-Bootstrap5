    font-weight: 600;
    color: var(--bs-dark);
}

.metadata-section .field-term {
    font-size: 0.75rem;
    background-color: var(--bs-gray-100);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
}

.metadata-section .value-text {
    font-size: 0.95rem;
    line-height: 1.5;
}

.metadata-section .language-tag {
    font-size: 0.7rem;
    vertical-align: top;
}

.metadata-section .uri-value a {
    color: var(--bs-primary);
    font-weight: 500;
}

.metadata-section .resource-value a {
    color: var(--bs-success);
    font-weight: 500;
}

