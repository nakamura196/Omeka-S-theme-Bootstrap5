@media (max-width: 768px) {
    .metadata-section .d-flex {
        flex-direction: column;
    }
    
    .metadata-section .value-meta {
        margin-left: 0 !important;
        margin-top: 0.5rem;
    }
}
</style>
<?php endif; ?>
