<?php
/**
 * Simple Hero Section Component
 * 
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\SiteRepresentation $site
 */

// Get site information
$site = $this->site;
$heroTitle = $site->title();
$heroDescription = $site->summary() ?: $this->translate('Explore our extensive collection of digital resources, documents, and media.');
$heroImage = $this->themeSettingAssetUrl('hero_image');
?>

<div class="position-relative overflow-hidden p-3 p-md-5 mb-4 text-center bg-dark text-white">
    <?php if ($heroImage): ?>
        <img src="<?php echo $this->escapeHtml($heroImage); ?>" 
             class="position-absolute top-0 start-0 w-100 h-100" 
             style="object-fit: cover; z-index: 0;" 
             alt="">
        <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark" style="opacity: 0.6; z-index: 1;"></div>
    <?php endif; ?>
    
    <div class="position-relative mx-auto py-5" style="z-index: 2;">
        <h1 class="display-4 fw-bold"><?php echo $this->escapeHtml($heroTitle); ?></h1>
        <p class="lead mx-auto" style="max-width: 700px;"><?php echo $this->escapeHtml($heroDescription); ?></p>
    </div>
</div>