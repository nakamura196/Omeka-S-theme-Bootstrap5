<?php
/**
 * Modern Hero Section Component
 * 
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\SiteRepresentation $site
 */

$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');

// Get site information
$site = $this->site;
$heroTitle = $site->title();
$heroDescription = $site->summary() ?: $translate('Explore our extensive collection of digital resources, documents, and media.');
$heroImage = $this->themeSettingAssetUrl('hero_image');
$heroButtonUrl = $this->themeSetting('hero_button_url');
$heroButtonText = $this->themeSetting('hero_button_text') ?: $translate('Explore Collections');
$heroButtonSecondaryUrl = $this->themeSetting('hero_button_secondary_url');
$heroButtonSecondaryText = $this->themeSetting('hero_button_secondary_text') ?: $translate('Search');

?>

<!-- モダンなヒーローセクション（Bootstrap 5） -->
<section class="hero-section position-relative overflow-hidden text-white">
    <!-- 背景画像またはグラデーション -->
    <?php if ($heroImage): ?>
    <div class="hero-background position-absolute top-0 start-0 w-100 h-100">
        <img src="<?php echo $escape($heroImage); ?>" 
             class="w-100 h-100" 
             style="object-fit: cover;" 
             alt="">
        <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark" 
             style="opacity: 0.5; background: linear-gradient(135deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.3) 100%);"></div>
    </div>
    <?php else: ?>
    <div class="hero-background position-absolute top-0 start-0 w-100 h-100" 
         style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"></div>
    <?php endif; ?>
    
    <!-- ヒーローコンテンツ -->
    <div class="container position-relative py-5">
        <div class="row align-items-center min-vh-50">
            <div class="col-lg-8 mx-auto text-center py-5">
                <!-- アニメーション付きタイトル -->
                <h1 class="display-3 fw-bold mb-4 animate-fade-in">
                    <?php echo $escape($heroTitle); ?>
                </h1>
                
                <!-- 説明文 -->
                <p class="lead mb-5 animate-fade-in-delay" style="max-width: 600px; margin: 0 auto;">
                    <?php echo $escape($heroDescription); ?>
                </p>
                
                <!-- CTAボタン -->
                <div class="d-flex flex-wrap gap-3 justify-content-center mb-5 animate-fade-in-delay-2">
                    <?php if ($heroButtonUrl): ?>
                    <a href="<?php echo $escape($heroButtonUrl); ?>" 
                       class="btn btn-primary btn-lg px-4 py-3 rounded-pill shadow">
                        <i class="bi bi-collection me-2"></i>
                        <?php echo $escape($heroButtonText); ?>
                    </a>
                    <?php endif; ?>
                    
                    <?php if ($heroButtonSecondaryUrl): ?>
                    <a href="<?php echo $escape($heroButtonSecondaryUrl); ?>" 
                       class="btn btn-outline-light btn-lg px-4 py-3 rounded-pill">
                        <i class="bi bi-search me-2"></i>
                        <?php echo $escape($heroButtonSecondaryText); ?>
                    </a>
                    <?php endif; ?>
                </div>
            </div>
        </div>
    </div>
    
    <!-- 装飾的な波形 -->
    <div class="hero-wave position-absolute bottom-0 start-0 w-100">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" preserveAspectRatio="none" style="height: 60px; width: 100%; display: block;">
            <path fill="#ffffff" fill-opacity="1" d="M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,122.7C672,117,768,139,864,133.3C960,128,1056,96,1152,90.7C1248,85,1344,107,1392,117.3L1440,128L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
        </svg>
