<?php
$escape = $this->plugin('escapeHtml');
$translate = $this->plugin('translate');
$required = $element->getAttribute('required');
$showRequired = $element->getOption('show_required');
$isRequired = null === $showRequired ? $required : $showRequired;
$class = $isRequired ? 'row mb-3 required' : 'row mb-3';
$escapeInfo = (false !== $element->getOption('escape_info'));
$fieldId = ($element->getAttribute('id')) ? 'id="' . $escape($element->getAttribute('id')) . '_field"' : '';

// Bootstrap 5クラスの追加
$inputType = $element->getAttribute('type');
$isCheckbox = ($inputType === 'checkbox');
$isRadio = ($inputType === 'radio');
$isTextarea = ($element instanceof \Laminas\Form\Element\Textarea);
?>
<?php if (null === $label || 'hidden' === $element->getAttribute('type')): ?>
<?php echo $this->formElement($element); ?>
<?php else: ?>
<div class="<?php echo $class ?>" <?php echo $fieldId; ?>>
    <?php if ($isCheckbox): ?>
        <!-- チェックボックス用のBootstrap 5水平レイアウト -->
        <div class="col-sm-10 offset-sm-2">
            <div class="form-check">
                <?php 
                // チェックボックスにBootstrap 5クラスを追加
                $existingClass = $element->getAttribute('class') ?: '';
                $newClass = trim($existingClass . ' form-check-input');
                $element->setAttribute('class', $newClass);
                echo $this->formElement($element); 
                ?>
                <?php 
                $checkboxLabel = $this->formLabel($element);
                // Bootstrap 5クラスを追加
                if ($checkboxLabel) {
                    $checkboxLabel = str_replace('<label', '<label class="form-check-label"', $checkboxLabel);
                }
                echo $checkboxLabel;
                ?>
            </div>
        </div>
    <?php elseif ($isRadio): ?>
        <!-- ラジオボタン用のBootstrap 5水平レイアウト -->
        <fieldset class="row mb-3">
            <legend class="col-form-label col-sm-2 pt-0">
                <?php 
                $label = $this->formLabel($element);
                // labelタグを削除してテキストのみを取得
                $labelText = strip_tags($label);
                echo $escape($labelText);
                ?>
            </legend>
            <div class="col-sm-10">
                <div class="form-check">
                    <?php 
                    $existingClass = $element->getAttribute('class') ?: '';
                    $newClass = trim($existingClass . ' form-check-input');
                    $element->setAttribute('class', $newClass);
                    echo $this->formElement($element); 
                    ?>
                    <?php 
                    $radioLabel = $this->formLabel($element);
                    if ($radioLabel) {
                        $radioLabel = str_replace('<label', '<label class="form-check-label"', $radioLabel);
                    }
                    echo $radioLabel;
                    ?>
                </div>
            </div>
        </fieldset>
    <?php else: ?>
        <!-- 通常のフィールド用のBootstrap 5水平レイアウト -->
        <?php 
        $label = $this->formLabel($element);
        // Bootstrap 5クラスを追加
        if ($label) {
            $label = str_replace('<label', '<label class="col-sm-2 col-form-label"', $label);
        }
        echo $label;
        ?>
        
        <div class="col-sm-10">
            <?php if ($info = $element->getOption('info')): ?>
            <div class="input-group">
                <?php 
                // 入力要素にBootstrap 5クラスを動的に追加
                $existingClass = $element->getAttribute('class') ?: '';
                if ($isTextarea) {
                    $newClass = trim($existingClass . ' form-control');
                    $element->setAttribute('class', $newClass);
                } elseif (in_array($inputType, ['text', 'search', 'email', 'url', 'password', 'date', 'datetime-local'])) {
                    $newClass = trim($existingClass . ' form-control');
                    $element->setAttribute('class', $newClass);
                } elseif ($inputType === 'select' || $element instanceof \Laminas\Form\Element\Select) {
                    $newClass = trim($existingClass . ' form-select');
                    $element->setAttribute('class', $newClass);
                }
                echo $this->formElement($element); 
                ?>
                <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#<?php echo $escape($element->getAttribute('id')); ?>_info" aria-expanded="false">
                    <i class="bi bi-info-circle"></i>
                </button>
            </div>
            <div class="collapse mt-2" id="<?php echo $escape($element->getAttribute('id')); ?>_info">
                <div class="alert alert-info">
                    <div class="field-description"><?php echo $escapeInfo ? $escape($translate($info)) : $translate($info); ?></div>
                    <?php if ($documentation = $element->getOption('documentation')): ?>
                    <a href="<?php echo $documentation; ?>" class="alert-link"><?php echo $translate('Learn more'); ?></a>
                    <?php endif; ?>
                </div>
            </div>
            <?php else: ?>
            <?php 
            // 入力要素にBootstrap 5クラスを動的に追加
            $existingClass = $element->getAttribute('class') ?: '';
            if ($isTextarea) {
                $newClass = trim($existingClass . ' form-control');
                $element->setAttribute('class', $newClass);
            } elseif (in_array($inputType, ['text', 'search', 'email', 'url', 'password', 'date', 'datetime-local'])) {
                $newClass = trim($existingClass . ' form-control');
                $element->setAttribute('class', $newClass);
            } elseif ($inputType === 'select' || $element instanceof \Laminas\Form\Element\Select) {
                $newClass = trim($existingClass . ' form-select');
                $element->setAttribute('class', $newClass);
            }
            echo $this->formElement($element); 
            ?>
            <?php endif; ?>
            
            <?php 
            $errors = $this->formElementErrors($element, ['class' => 'invalid-feedback d-block']);
            if ($errors): ?>
                <?php echo $errors; ?>
            <?php endif; ?>
        </div>
    <?php endif; ?>
</div>
<?php endif; ?>
