<?php
// Rendered by the view helper languageSwitcher() of the module Internationalisation (see common/header.phtml).
// $locales: one entry per site of the group, with "locale", "locale_label" and "url" (the same page in that site).
// $defaultLocale: the locale of the install, used when the site has none.
$escape = $this->plugin('escapeHtml');
$translate = $this->plugin('translate');

// Nothing to switch to when the site is not in a group of translated sites.
if (count($locales) <= 1) {
    return;
}

$currentLocale = $this->siteSetting('locale') ?: $defaultLocale;

// When a page has no translation, the module links the other languages to the
// current page itself, so the switch does nothing. Link to the homepage of the
// other site instead.
$currentUrl = null;
foreach ($locales as $locale) {
    if ($locale['locale'] == $currentLocale) {
        $currentUrl = $locale['url'];
        break;
    }
}
if ($currentUrl !== null) {
    $url = $this->plugin('url');
    foreach ($locales as $key => $locale) {
        if ($locale['locale'] != $currentLocale && $locale['url'] === $currentUrl && !empty($locale['site'])) {
            $locales[$key]['url'] = $url('site', ['site-slug' => $locale['site']]);
        }
    }
}

$code = function ($locale) {
    return rtrim(substr($locale, 0, 3), '_-');
};
?>
<details class="language-menu">
    <summary class="btn btn-sm" title="<?php echo $escape($translate('Language')); ?>">
        <i class="fa-solid fa-globe" aria-hidden="true"></i>
        <span class="language-code"><?php echo $escape($code($currentLocale)); ?></span>
        <span class="visually-hidden"><?php echo $escape($translate('Language')); ?></span>
    </summary>
    <ul>
        <?php foreach ($locales as $locale): ?>
        <li><a href="<?php echo $escape($locale['url']); ?>" hreflang="<?php echo $escape(str_replace('_', '-', $locale['locale'])); ?>"<?php echo $locale['locale'] == $currentLocale ? ' aria-current="true"' : ''; ?>><?php echo $escape($locale['locale_label']); ?></a></li>
        <?php endforeach; ?>
    </ul>
</details>
