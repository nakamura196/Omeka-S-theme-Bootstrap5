<?php
/**
 * Item sets block layout partial template
 * 
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var array $itemSets
 */

$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;
?>

<?php if ($itemSets): ?>
<div class="item-sets-section my-5">
    <div class="card">
        <div class="card-header bg-primary bg-opacity-10">
            <h5 class="mb-0">
                <i class="bi bi-collection me-2"></i><?= $translate('Item Sets') ?>
                <span class="badge bg-secondary ms-2"><?= count($itemSets) ?></span>
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <?php foreach ($itemSets as $itemSet): ?>
                <div class="col-md-6 col-lg-4">
                    <div class="item-set-card h-100">
                        <a href="<?= $escape($itemSet->url()) ?>" class="text-decoration-none">
                            <div class="d-flex align-items-center p-3 border rounded hover-shadow h-100">
                                <div class="flex-shrink-0">
                                    <div class="icon-wrapper bg-primary bg-opacity-10 rounded-circle p-3">
                                        <i class="bi bi-folder2-open text-primary fs-4"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="mb-1 text-dark">
                                        <?= $escape($itemSet->displayTitle(null, $valueLang)) ?>
                                    </h6>
                                    <?php 
                                    $description = $itemSet->displayDescription();
                                    if ($description): 
                                    ?>
                                    <p class="text-muted small mb-0">
                                        <?= $escape(mb_substr($description, 0, 80)) ?><?= mb_strlen($description) > 80 ? '...' : '' ?>
                                    </p>
                                    <?php endif; ?>
                                    <div class="mt-2">
                                        <span class="badge bg-light text-dark">
                                            <i class="bi bi-hash me-1"></i><?= $escape($itemSet->id()) ?>
                                        </span>
                                        <?php 
                                        $itemCount = $itemSet->itemCount();
                                        if ($itemCount !== null): 
                                        ?>
                                        <span class="badge bg-info text-white ms-1">
                                            <?= sprintf($translate('%d items'), $itemCount) ?>
                                        </span>
                                        <?php endif; ?>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
                <?php endforeach; ?>
            </div>
        </div>
    </div>
</div>

<style>
.item-set-card .hover-shadow {
    transition: all 0.3s ease;
    background-color: #fff;
}

.item-set-card:hover .hover-shadow {
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    transform: translateY(-2px);
    background-color: #f8f9fa;
}

.item-set-card .icon-wrapper {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.item-set-card h6 {
    transition: color 0.3s ease;
}

.item-set-card:hover h6 {
    color: #0d6efd !important;
}
</style>
<?php endif; ?>