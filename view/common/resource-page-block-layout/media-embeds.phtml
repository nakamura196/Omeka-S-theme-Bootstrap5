<?php
/**
 * Media Embeds Block Layout - Bootstrap 5 版
 * アイテムページでメディアファイルをスライダー形式で表示
 */
$translate = $this->plugin('translate');
$resourceMedia = $resource->media();
?>

<?php if ($resourceMedia): ?>
<div class="media-embeds-section my-5">
    <?php 
    $mediaCount = count($resourceMedia);
    $hasMultiple = $mediaCount > 1;
    ?>
    
    <?php if ($hasMultiple): ?>
    <!-- 複数メディアの場合はカルーセル表示 -->
    <div id="mediaCarousel" class="carousel slide" data-bs-ride="false">
        <!-- インジケーター -->
        <div class="carousel-indicators">
            <?php foreach ($resourceMedia as $index => $media): ?>
            <button type="button" 
                    data-bs-target="#mediaCarousel" 
                    data-bs-slide-to="<?php echo $index; ?>" 
                    <?php echo $index === 0 ? 'class="active" aria-current="true"' : ''; ?>
                    aria-label="<?php echo sprintf($translate('Slide %d'), $index + 1); ?>">
            </button>
            <?php endforeach; ?>
        </div>
        
        <!-- カルーセル本体 -->
        <div class="carousel-inner">
            <?php foreach ($resourceMedia as $index => $media): ?>
            <div class="carousel-item <?php echo $index === 0 ? 'active' : ''; ?>">
                <div class="media-container text-center">
                    <?php 
                    // メディアタイプの判定
                    $mediaType = $media->mediaType();
                    $isImage = strpos($mediaType, 'image/') === 0;
                    $isVideo = strpos($mediaType, 'video/') === 0;
                    $isAudio = strpos($mediaType, 'audio/') === 0;
                    $isPdf = $mediaType === 'application/pdf';
                    ?>
                    
                    <?php if ($isImage): ?>
                        <!-- 画像の場合 -->
                        <div class="image-wrapper">
                            <?php echo $media->render(['link_type' => 'original']); ?>
                        </div>
                    <?php elseif ($isVideo || $isAudio): ?>
                        <!-- 動画・音声の場合 -->
                        <div class="media-player-wrapper">
                            <?php echo $media->render(); ?>
                        </div>
                    <?php elseif ($isPdf): ?>
                        <!-- PDFの場合 -->
                        <div class="pdf-wrapper">
                            <?php echo $media->render(); ?>
                            <div class="mt-3">
                                <a href="<?php echo $media->originalUrl(); ?>" 
                                   class="btn btn-outline-primary" 
                                   target="_blank">
                                    <i class="bi bi-download me-2"></i><?php echo $translate('Download PDF'); ?>
                                </a>
                            </div>
                        </div>
                    <?php else: ?>
                        <!-- その他のファイル -->
                        <div class="file-wrapper">
                            <?php echo $media->render(); ?>
                        </div>
                    <?php endif; ?>
                    
                    <!-- メディア情報 -->
                    <div class="media-info mt-3">
                        <h6 class="media-title"><?php echo $media->displayTitle(); ?></h6>
                        <?php if ($media->displayDescription()): ?>
                        <p class="text-muted small"><?php echo $media->displayDescription(); ?></p>
                        <?php endif; ?>
                    </div>
                </div>
            </div>
            <?php endforeach; ?>
        </div>
        
        <!-- コントロールボタン -->
        <button class="carousel-control-prev" type="button" data-bs-target="#mediaCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden"><?php echo $translate('Previous'); ?></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#mediaCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden"><?php echo $translate('Next'); ?></span>
        </button>
    </div>
    
    <!-- サムネイルナビゲーション -->
    <div class="media-thumbnails mt-3">
        <div class="row g-2 justify-content-center">
            <?php foreach ($resourceMedia as $index => $media): ?>
            <div class="col-auto">
                <button class="thumbnail-btn <?php echo $index === 0 ? 'active' : ''; ?>" 
                        data-bs-target="#mediaCarousel" 
                        data-bs-slide-to="<?php echo $index; ?>"
                        type="button">
                    <?php if ($media->hasThumbnails()): ?>
                        <img src="<?php echo $media->thumbnailUrl('square'); ?>" 
                             alt="<?php echo $this->escapeHtml($media->displayTitle()); ?>"
                             class="img-fluid">
                    <?php else: ?>
                        <div class="thumbnail-placeholder">
                            <i class="bi bi-file-earmark"></i>
                        </div>
                    <?php endif; ?>
                </button>
            </div>
            <?php endforeach; ?>
        </div>
    </div>
    
    <?php else: ?>
    <!-- 単一メディアの場合 -->
    <div class="single-media-container">
        <?php $media = $resourceMedia[0]; ?>
        <?php 
        $mediaType = $media->mediaType();
        $isImage = strpos($mediaType, 'image/') === 0;
        ?>
        
        <div class="media-wrapper text-center">
            <?php if ($isImage): ?>
                <div class="image-wrapper">
                    <?php echo $media->render(['link_type' => 'original']); ?>
                </div>
            <?php else: ?>
                <?php echo $media->render(); ?>
            <?php endif; ?>
            
            <!-- メディア情報 -->
            <div class="media-info mt-3">
                <h6 class="media-title"><?php echo $media->displayTitle(); ?></h6>
                <?php if ($media->displayDescription()): ?>
                <p class="text-muted small"><?php echo $media->displayDescription(); ?></p>
                <?php endif; ?>
            </div>
        </div>
    </div>
    <?php endif; ?>
</div>

<!-- カスタムスタイル -->
