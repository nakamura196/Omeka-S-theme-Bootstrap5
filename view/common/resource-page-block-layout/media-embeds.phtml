    display: inline-block;
}

/* メディアプレイヤー */
.media-embeds-section .media-player-wrapper video,
.media-embeds-section .media-player-wrapper audio {
    max-width: 100%;
}

/* PDFビューワー */
.media-embeds-section .pdf-wrapper iframe {
    width: 100%;
    height: 500px;
    border: none;
}

