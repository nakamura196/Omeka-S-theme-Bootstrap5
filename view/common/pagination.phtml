<?php
// Result count, a page number box and previous / next buttons.
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');

// Do not emit the sort default flags, nor the sorts they stand for (as core 4.2.1 does).
$removeQueries = ['page', 'sort_by_default', 'sort_order_default'];
if (isset($query['sort_by_default'])) {
    $removeQueries[] = 'sort_by';
}
if (isset($query['sort_order_default'])) {
    $removeQueries[] = 'sort_order';
}
$from = $offset + 1;
$to = ($currentPage < $pageCount) ? $offset + $perPage : $totalCount;
?>
<nav class="d-flex flex-wrap align-items-center gap-3" aria-label="<?php echo $escape($translate('Pagination')); ?>">
<?php if ($totalCount): ?>
    <span class="row-count">
        <?php echo sprintf($escape($translate('%1$s–%2$s of %3$s')), number_format($from), number_format($to), '<strong>' . number_format($totalCount) . '</strong>'); ?>
    </span>
    <?php if ($pageCount > 1): ?>
    <form method="GET" action="" class="pager">
        <?php echo $this->queryToHiddenInputs($removeQueries); ?>
        <?php if ($currentPage > 1): ?>
        <a class="btn btn-sm btn-outline-primary" href="<?php echo $escape($previousPageUrl); ?>" rel="prev" title="<?php echo $escape($translate('Previous')); ?>" aria-label="<?php echo $escape($translate('Previous')); ?>"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></a>
        <?php else: ?>
        <span class="btn btn-sm btn-outline-primary disabled" aria-hidden="true"><i class="fa-solid fa-chevron-left"></i></span>
        <?php endif; ?>
        <input type="number" name="page" class="form-control form-control-sm page-input" value="<?php echo (int) $currentPage; ?>" min="1" max="<?php echo (int) $pageCount; ?>" aria-label="<?php echo $escape($translate('Page')); ?>">
        <span class="page-count">/ <?php echo number_format($pageCount); ?></span>
        <?php if ($currentPage < $pageCount): ?>
        <a class="btn btn-sm btn-outline-primary" href="<?php echo $escape($nextPageUrl); ?>" rel="next" title="<?php echo $escape($translate('Next')); ?>" aria-label="<?php echo $escape($translate('Next')); ?>"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>
        <?php else: ?>
        <span class="btn btn-sm btn-outline-primary disabled" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></span>
        <?php endif; ?>
    </form>
    <?php endif; ?>
<?php else: ?>
    <span class="row-count"><?php echo $escape($translate('0 results')); ?></span>
<?php endif; ?>
</nav>
