<?php
$translate = $this->plugin('translate');

// Do not emit the sort default flags.
$removeQueries = ['page', 'sort_by_default', 'sort_order_default'];
// Do not emit sorts if the corresponding default sort flags are set.
if (isset($query['sort_by_default'])) {
    $removeQueries[] = 'sort_by';
}
if (isset($query['sort_order_default'])) {
    $removeQueries[] = 'sort_order';
}
?>
<?php if ($totalCount): ?>
<nav aria-label="<?php echo $translate('Pagination'); ?>">
    <div class="d-flex align-items-center gap-3">
        <!-- ページ入力フォーム -->
        <form method="GET" action="" class="d-flex align-items-center">
            <?php echo $this->queryToHiddenInputs($removeQueries); ?>
            <div class="input-group input-group-sm" style="width: 180px;">
                <input type="text" name="page" class="form-control" value="<?php echo $currentPage; ?>" 
                       <?php echo ($pageCount == 1) ? 'readonly' : ''; ?> 
                       aria-label="<?php echo $translate('Page'); ?>">
                <span class="input-group-text">/ <?php echo number_format($pageCount); ?> <?php echo $translate('Page'); ?></span>
            </div>
        </form>

        <!-- 前へ・次へボタン -->
        <div class="btn-group" role="group" aria-label="<?php echo $translate('Pagination'); ?>">
            <?php if ($currentPage > 1): ?>
            <a href="<?php echo $previousPageUrl; ?>" class="btn btn-outline-secondary btn-sm" aria-label="<?php echo $translate('Previous'); ?>">
                <i class="fas fa-chevron-left" aria-hidden="true"></i>
            </a>
            <?php else: ?>
            <button class="btn btn-outline-secondary btn-sm" disabled aria-label="<?php echo $translate('Previous'); ?>">
                <i class="fas fa-chevron-left" aria-hidden="true"></i>
            </button>
            <?php endif; ?>

            <?php if ($currentPage < $pageCount): ?>
            <a href="<?php echo $nextPageUrl; ?>" class="btn btn-outline-secondary btn-sm" aria-label="<?php echo $translate('Next'); ?>">
                <i class="fas fa-chevron-right" aria-hidden="true"></i>
            </a>
            <?php else: ?>
            <button class="btn btn-outline-secondary btn-sm" disabled aria-label="<?php echo $translate('Next'); ?>">
                <i class="fas fa-chevron-right" aria-hidden="true"></i>
            </button>
            <?php endif; ?>
        </div>
    </div>
</nav>
<?php else: ?>
<div class="alert alert-info text-center">
    <?php echo $translate('0 results'); ?>
</div>
<?php endif; ?>
