<?php
/**
 * Custom popup content for map markers
 * 
 * @var \Mapping\Api\Representation\FeatureRepresentation $feature
 */

$label = $feature->label();
$media = $feature->media();
$item = $feature->item();
$title = $item->displayTitle(null, $this->lang());

// 説明文を複数の方法で取得を試みる
$description = null;

// 方法1: dcterms:description
if (!$description) {
    $description = $item->value('dcterms:description', ['type' => 'literal', 'lang' => $this->lang()]);
}

// 方法2: dcterms:abstract
if (!$description) {
    $description = $item->value('dcterms:abstract', ['type' => 'literal', 'lang' => $this->lang()]);
}

// 方法3: description（基本的なdescriptionプロパティ）
if (!$description) {
    $description = $item->value('description', ['type' => 'literal', 'lang' => $this->lang()]);
}

// 方法4: displayDescription メソッドがある場合
if (!$description && method_exists($item, 'displayDescription')) {
    $description = $item->displayDescription();
}
?>

<div class="map-popup-content">
    <div class="popup-header">
        <h4 class="popup-title">
            <?php echo $item->link($this->escapeHtml($title), null, ['target' => '_blank']); ?>
        </h4>
        <?php if ($label): ?>
        <small class="text-muted"><?php echo $this->escapeHtml($label); ?></small>
        <?php endif; ?>
    </div>
    
    <div class="popup-body">
        <?php 
        // メディアがない場合、アイテムの最初のメディアを取得
        if (!$media && $item->media()) {
            $medias = $item->media();
            if (count($medias) > 0) {
                $media = $medias[0];
            }
        }
        
        if ($media): 
        ?>
        <div class="popup-media">
            <?php 
            // サムネイル画像のURLを取得（複数の方法を試す）
            $thumbnailUrl = null;
            
            // 方法1: thumbnailUrlメソッドを使用
            if (method_exists($media, 'thumbnailUrl')) {
                $thumbnailUrl = $media->thumbnailUrl('medium');
            }
            
            // 方法2: thumbnailメソッドを使用
            if (!$thumbnailUrl && method_exists($media, 'thumbnail')) {
                $thumbnailUrl = $media->thumbnail('medium');
            }
            
            // 方法3: primaryMediaを使用
            if (!$thumbnailUrl && method_exists($media, 'primaryMedia')) {
                $primaryMedia = $media->primaryMedia();
                if ($primaryMedia) {
                    $thumbnailUrl = $primaryMedia->thumbnailUrl('medium');
                }
            }
            
            if ($thumbnailUrl):
            ?>
            <a href="<?php echo $this->escapeHtml($item->url()); ?>" target="_blank">
                <img src="<?php echo $this->escapeHtml($thumbnailUrl); ?>" 
                     alt="<?php echo $this->escapeHtml($title); ?>" 
                     class="popup-thumbnail"
                     onerror="this.style.display='none'">
            </a>
            <?php else: ?>
            <!-- サムネイルが取得できない場合のフォールバック -->
            <div class="no-thumbnail">
                <i class="bi bi-image" style="font-size: 48px; color: #ccc;"></i>
            </div>
            <?php endif; ?>
        </div>
        <?php endif; ?>
        
        <div class="popup-content">
            <?php 
            // 説明文が存在し、空でない場合に表示
            if ($description && trim($description)): 
                $descriptionText = is_object($description) ? (string)$description : $description;
                $descriptionText = strip_tags($descriptionText); // HTMLタグを除去
                $descriptionText = trim($descriptionText);
                
                if ($descriptionText):
            ?>
            <div class="popup-description">
                <p><?php echo $this->escapeHtml(mb_substr($descriptionText, 0, 180)); ?><?php echo mb_strlen($descriptionText) > 180 ? '...' : ''; ?></p>
            </div>
            <?php 
                endif;
            endif; 
            ?>
            
            <div class="popup-footer">
                <a href="<?php echo $this->escapeHtml($item->url()); ?>" 
                   target="_blank" 
                   class="popup-detail-btn">
                    詳細を見る
                </a>
            </div>
        </div>
    </div>
</div>

<style>
