<script>
document.addEventListener('DOMContentLoaded', function() {
    // Translations for JavaScript
    const translations = {
        'Filters': <?= json_encode($translate('Filters')) ?>,
        'Add': <?= json_encode($translate('Add')) ?>,
        'Remove': <?= json_encode($translate('Remove')) ?>,
        'Add a filter': <?= json_encode($translate('Add a filter')) ?>,
        'Remove this filter': <?= json_encode($translate('Remove this filter')) ?>,
        'Reset fields': <?= json_encode($translate('Reset fields')) ?>,
        'Search': <?= json_encode($translate('Search')) ?>,
        'and': <?= json_encode($translate('and')) ?>,
        'or': <?= json_encode($translate('or')) ?>,
        'not': <?= json_encode($translate('not')) ?>,
        'AND': <?= json_encode($translate('AND')) ?>,
        'OR': <?= json_encode($translate('OR')) ?>,
        'NOT': <?= json_encode($translate('NOT')) ?>
    };
    
    // Translate function
    function t(key) {
        return translations[key] || key;
    }
    
    // Translate select options for join/joiner (and, or, not)
    function translateSelectOptions() {
        // Find all select elements with join/joiner in their name
        const joinSelects = document.querySelectorAll('select[name*="join"], select.joiner');
        joinSelects.forEach(function(select) {
            const options = select.querySelectorAll('option');
            options.forEach(function(option) {
                const value = option.value.toLowerCase();
                const text = option.textContent.trim();
                const textLower = text.toLowerCase();
                // Translate common logical operators
                if (value === 'and' || textLower === 'and') {
                    // Keep original case if uppercase
                    option.textContent = (text === 'AND') ? t('AND') : t('and');
                } else if (value === 'or' || textLower === 'or') {
                    option.textContent = (text === 'OR') ? t('OR') : t('or');
                } else if (value === 'not' || textLower === 'not') {
                    option.textContent = (text === 'NOT') ? t('NOT') : t('not');
                }
            });
        });
    }
    
    // Apply translations on page load
    translateSelectOptions();
    
    // Add icons to submit and reset buttons
    const submitBtn = document.querySelector('button[type="submit"]#search-submit, button[name="submit"]');
    if (submitBtn && !submitBtn.querySelector('i')) {
        const icon = document.createElement('i');
        icon.className = 'bi bi-search me-2';
        submitBtn.insertBefore(icon, submitBtn.firstChild);
    }
    
    const resetBtn = document.querySelector('button[type="reset"], button[name="form-reset"]');
    if (resetBtn && !resetBtn.querySelector('i')) {
        const icon = document.createElement('i');
        icon.className = 'bi bi-arrow-clockwise me-2';
        resetBtn.insertBefore(icon, resetBtn.firstChild);
    }
    
    // Fix Bootstrap row/col structure for filter fields
    function fixFilterLayout() {
        // Remove Bootstrap row/col structure from filter fields
        const filterFieldsets = document.querySelectorAll('#search-filters fieldset.filter');
        filterFieldsets.forEach(function(fieldset) {
            // Find the row with the remove button
            const rowDiv = fieldset.querySelector('.row.mb-3');
            if (rowDiv) {
                // Extract the button
                const removeBtn = rowDiv.querySelector('button.search-filter-minus');
                if (removeBtn) {
                    // Move button out of row structure
                    fieldset.appendChild(removeBtn);
                }
                // Remove the row div
                rowDiv.remove();
            }
            
            // Wrap filter elements in a flex container
            const elements = Array.from(fieldset.children);
            const wrapper = document.createElement('div');
            wrapper.className = 'filter-row-wrapper';
            
            elements.forEach(function(el) {
                if (el.tagName !== 'LEGEND' && !el.classList.contains('filter-row-wrapper')) {
                    wrapper.appendChild(el);
                }
            });
            
            fieldset.appendChild(wrapper);
        });
        
        // Fix the main filter fieldset structure
        const mainFilterFieldset = document.querySelector('#search-filters');
        if (mainFilterFieldset) {
            // Move the add button to the legend area
            const addBtn = mainFilterFieldset.querySelector('button.search-filter-plus');
            const legend = mainFilterFieldset.querySelector('legend:not([hidden])');
            if (addBtn && legend) {
                // Translate legend text if it's "Filters"
                if (legend.textContent.trim() === 'Filters') {
                    legend.textContent = t('Filters');
                }
                const legendWrapper = document.createElement('div');
                legendWrapper.className = 'filter-legend-wrapper';
                legendWrapper.appendChild(legend);
                legendWrapper.appendChild(addBtn);
                mainFilterFieldset.insertBefore(legendWrapper, mainFilterFieldset.firstChild);
            }
        }
    }
    
    // Add Bootstrap Icons to empty buttons
    const addButtons = document.querySelectorAll('.search-form-content button.search-filter-plus, .search-form-content button.add-value, .search-form-content button.o-icon-add');
    addButtons.forEach(function(button) {
        if (button.innerHTML.trim() === '') {
            button.innerHTML = '<i class="bi bi-plus-circle"></i>';
            button.title = button.getAttribute('aria-label') || t('Add a filter');
        }
    });
    
    const removeButtons = document.querySelectorAll('.search-form-content button.search-filter-minus, .search-form-content button.remove-value, .search-form-content button.o-icon-delete');
    removeButtons.forEach(function(button) {
        if (button.innerHTML.trim() === '') {
            button.innerHTML = '<i class="bi bi-trash"></i>';
            button.title = button.getAttribute('aria-label') || t('Remove this filter');
        }
    });
    
    // Apply layout fixes
    fixFilterLayout();
    
    // Handle dynamically added buttons and fix their layout
    const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
            mutation.addedNodes.forEach(function(node) {
                if (node.nodeType === 1) { // Element node
                    // Check if it's a filter fieldset
                    if (node.matches && node.matches('fieldset.filter')) {
                        // Apply layout fix to the new fieldset
                        setTimeout(function() {
                            // Find the row with the remove button
                            const rowDiv = node.querySelector('.row.mb-3');
                            if (rowDiv) {
                                // Extract the button
                                const removeBtn = rowDiv.querySelector('button.search-filter-minus');
                                if (removeBtn) {
                                    // Add icon if empty
                                    if (removeBtn.innerHTML.trim() === '') {
                                        removeBtn.innerHTML = '<i class="bi bi-trash"></i>';
                                        removeBtn.title = removeBtn.getAttribute('aria-label') || t('Remove this filter');
                                    }
                                    // Move button out of row structure
                                    node.appendChild(removeBtn);
                                }
                                // Remove the row div
                                rowDiv.remove();
                            }
                            
                            // Wrap filter elements in a flex container
                            const elements = Array.from(node.children);
                            const wrapper = document.createElement('div');
                            wrapper.className = 'filter-row-wrapper';
                            
                            elements.forEach(function(el) {
                                if (el.tagName !== 'LEGEND' && !el.classList.contains('filter-row-wrapper')) {
                                    wrapper.appendChild(el);
                                }
                            });
                            
                            node.appendChild(wrapper);
                            
                            // Translate options in the new filter
                            const selects = node.querySelectorAll('select[name*="join"], select.joiner');
                            selects.forEach(function(select) {
                                const options = select.querySelectorAll('option');
                                options.forEach(function(option) {
                                    const value = option.value.toLowerCase();
                                    const text = option.textContent.trim();
                                    const textLower = text.toLowerCase();
                                    if (value === 'and' || textLower === 'and') {
                                        option.textContent = (text === 'AND') ? t('AND') : t('and');
                                    } else if (value === 'or' || textLower === 'or') {
                                        option.textContent = (text === 'OR') ? t('OR') : t('or');
                                    } else if (value === 'not' || textLower === 'not') {
                                        option.textContent = (text === 'NOT') ? t('NOT') : t('not');
                                    }
                                });
                            });
                        }, 10);
                    }
                    
                    // Check for add buttons
                    if (node.matches && (node.matches('.search-filter-plus') || node.matches('.add-value') || node.matches('.o-icon-add'))) {
                        if (node.innerHTML.trim() === '') {
                            node.innerHTML = '<i class="bi bi-plus-circle"></i>';
                            node.title = node.getAttribute('aria-label') || t('Add a filter');
                        }
                    }
                    // Check for remove buttons
                    if (node.matches && (node.matches('.search-filter-minus') || node.matches('.remove-value') || node.matches('.o-icon-delete'))) {
                        if (node.innerHTML.trim() === '') {
                            node.innerHTML = '<i class="bi bi-trash"></i>';
                            node.title = node.getAttribute('aria-label') || t('Remove this filter');
                        }
                    }
                    // Check child elements
                    const addBtns = node.querySelectorAll ? node.querySelectorAll('.search-filter-plus, .add-value, .o-icon-add') : [];
                    addBtns.forEach(function(btn) {
                        if (btn.innerHTML.trim() === '') {
                            btn.innerHTML = '<i class="bi bi-plus-circle"></i>';
                            btn.title = btn.getAttribute('aria-label') || t('Add a filter');
                        }
                    });
                    const removeBtns = node.querySelectorAll ? node.querySelectorAll('.search-filter-minus, .remove-value, .o-icon-delete') : [];
                    removeBtns.forEach(function(btn) {
                        if (btn.innerHTML.trim() === '') {
                            btn.innerHTML = '<i class="bi bi-trash"></i>';
                            btn.title = btn.getAttribute('aria-label') || t('Remove this filter');
                        }
                    });
                }
            });
        });
    });
    
    // Observe the form for changes
    const searchForm = document.querySelector('.search-form-content');
    if (searchForm) {
        observer.observe(searchForm, { childList: true, subtree: true });
    }
});
</script>
