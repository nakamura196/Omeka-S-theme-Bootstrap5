<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \AdvancedSearch\Form\MainSearchForm $form
 * @var \AdvancedSearch\Api\Representation\SearchConfigRepresentation $searchConfig
 */

// Scripts are loaded via an event on view.layout and can be managed in search-form-main-header.phtml.

$translate = $this->plugin('translate');

$params = $this->params()->fromQuery() ?: [];
$form
    ->setData($params)
    ->prepare();

$formId = $form->getAttribute('id');
if (!$formId) {
    $formId = 'form-search';
    $form->setAttribute('id', $formId);
}

// Move buttons reset and submit outside of the form.
$reset = null;
$submit = null;
if ($form->has('form-reset')) {
    $reset = $form->get('form-reset');
    $reset
        ->setAttribute('form', $formId)
        ->setAttribute('class', 'btn btn-outline-secondary me-2');
    $form->remove('form-reset');
}
if ($form->has('submit')) {
    $submit = $form->get('submit');
    $submit
        ->setAttribute('form', $formId)
        ->setAttribute('class', 'btn btn-primary');
    $form->remove('submit');
}

// To avoid to display all advanced search filters, so the js just add new ones:
// TODO This new mechanism requires to update the js.
/** @var \Laminas\Form\Fieldset $filters */
/*
$filters = $form->get('filter');
if ($filters) {
    $defaultCount = (int) $filters->getAttribute('data-count-default');
    $i = 0;
    foreach ($filters->getFieldsets() as $name => $element) {
        if (++$i > max($defaultCount, count($params['filter']))) {
            $filters->remove($name);
        }
    }
}
*/
?>

<!-- モダンな検索フォーム（Bootstrap 5） -->
<div id="advanced-search-form-wrapper" class="search-form-modern">
    <div id="advanced-search-form">
            <?= $this->form()->openTag($form) ?>
            
            <!-- フォームフィールド -->
            <div class="search-form-fields">
                <?php
                // フォームをフィールドごとにカスタマイズ
                foreach ($form as $element):
                    if ($element instanceof \Laminas\Form\Fieldset):
                        // フィールドセットの場合
                        ?>
                        <div class="mb-4">
                            <?php if ($element->getLabel()): ?>
                            <h6 class="fw-bold mb-3 text-secondary">
                                <i class="bi bi-filter-circle me-1"></i>
                                <?= $translate($element->getLabel()) ?>
                            </h6>
                            <?php endif; ?>
                            
                            <div class="row g-3">
                                <?php foreach ($element as $subElement): ?>
                                <div class="col-md-6">
                                    <?php
                                    // Bootstrap 5のフォームコントロールクラスを追加
                                    $subElement->setAttribute('class', 'form-control');
                                    if ($subElement->getLabel()): ?>
                                    <label class="form-label text-muted small">
                                        <?= $translate($subElement->getLabel()) ?>
                                    </label>
                                    <?php endif; ?>
                                    <?= $this->formElement($subElement) ?>
                                </div>
                                <?php endforeach; ?>
                            </div>
                        </div>
                        <?php
                    else:
                        // 通常のフォーム要素の場合
                        $element->setAttribute('class', 'form-control');
                        ?>
                        <div class="mb-3">
                            <?php if ($element->getLabel()): ?>
                            <label class="form-label">
                                <?= $translate($element->getLabel()) ?>
                            </label>
                            <?php endif; ?>
                            <?= $this->formElement($element) ?>
                        </div>
                        <?php
                    endif;
                endforeach;
                ?>
            </div>
            
            <!-- 検索ボタン -->
            <div class="search-form-buttons d-flex justify-content-center gap-2 mt-4 pt-3 border-top">
                <?php if ($reset): ?>
                <button type="button" 
                        form="<?= $formId ?>" 
                        class="btn btn-outline-secondary px-4"
                        onclick="document.getElementById('<?= $formId ?>').reset(); return false;">
                    <i class="bi bi-arrow-clockwise me-2"></i>
                    <?= $translate('Reset') ?>
                </button>
                <?php endif; ?>
                
                <?php if ($submit): 
                    $submit->setAttribute('class', 'btn btn-primary px-5');
                    $submit->setLabel('<i class="bi bi-search me-2"></i>' . $translate('Search'));
                    $submit->setLabelOption('disable_html_escape', true);
                ?>
                <?= $this->formButton($submit) ?>
                <?php endif; ?>
            </div>
            
            <?= $this->form()->closeTag() ?>
    </div>
</div>

<style>
/* 検索フォームのカスタムスタイル */
.search-form-modern .form-control:focus {
    border-color: var(--bs-primary);
    box-shadow: 0 0 0 0.25rem rgba(var(--bs-primary-rgb), 0.25);
}

/* フィールドセットのスタイル */
.search-form-fields .form-label {
    font-weight: 500;
    margin-bottom: 0.5rem;
}

/* レスポンシブ調整 */
@media (max-width: 768px) {
    .search-form-buttons {
        flex-direction: column;
    }
    
    .search-form-buttons .btn {
        width: 100%;
    }
}
</style>