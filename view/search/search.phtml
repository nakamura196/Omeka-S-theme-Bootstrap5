<?php endif; ?>
<?php endif; ?>

<div id="search-page" class="search-page-modern">
<?php endif; // End NOT partial. ?>

<?php if ($displayItemSet): ?>

    <?php
    $vars->offsetSet('resourceType', 'item_sets');
    $this->htmlElement('body')->appendAttribute('class', 'search-page item-set resource browse');
    ?>
    <!-- アイテムセットヘッダー -->
    <div class="item-set-header bg-light py-4 mb-4">
        <div class="container">
            <h1 class="display-6 fw-bold mb-2"><?= $itemSet->displayTitle(null, $langValue) ?></h1>
            <p class="text-muted mb-0">
                <i class="bi bi-folder me-2"></i><?= $translate('Item set') ?>
            </p>
        </div>
    </div>
    
    <div class="container">
        <div class="metadata mb-4">
            <?= $this->resourcePageBlocks($itemSet)->getBlocks() ?>
        </div>
        <div class="item-set-items">
            <h3 class="h4 fw-bold mb-3">
                <i class="bi bi-collection me-2"></i><?= $translate('Items') ?>
            </h3>
        </div>
    </div>

<?php else: ?>

    <?php
    if ($query->isBrowse()) {
        $mainTitle = $translate($searchConfig->subSetting('results', 'label_default') ?: 'Search');
    } else {
        $mainTitle = $response->getTotalResults()
            ? sprintf($translate('%d Results'), $response->getTotalResults())
            : $translate('No results');
    }
    
    $this->htmlElement('body')->appendAttribute('class', 'search-page resource browse');
    ?>
    
    <!-- 検索ページヘッダー -->
    <div class="search-header bg-light py-5 mb-5">
        <div class="container text-center">
            <h1 class="display-5 fw-bold mb-3">
                <i class="bi bi-search me-3"></i><?= $mainTitle ?>
            </h1>
            <?php if ($response->getTotalResults()): ?>
            <p class="text-muted mb-0">
                <?= sprintf($translate('Found %d items matching your search'), $response->getTotalResults()) ?>
            </p>
            <?php endif; ?>
        </div>
    </div>

<?php endif; ?>

<!-- 検索フォーム -->
<div class="search-form-section mb-5">
    <div class="container">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <button class="btn btn-link text-decoration-none p-0 w-100 text-start collapsed" 
                        type="button" 
                        id="searchFormToggle"
                        data-bs-toggle="collapse" 
                        data-bs-target="#searchFormCollapse" 
                        aria-expanded="false" 
                        aria-controls="searchFormCollapse">
                    <h5 class="mb-0 d-flex align-items-center justify-content-between">
                        <span>
                            <i class="bi bi-funnel me-2"></i>
                            <?= $translate('Advanced Search') ?>
                        </span>
                        <i class="bi bi-chevron-down"></i>
                    </h5>
                </button>
            </div>
            <div id="searchFormCollapse" class="collapse">
                <div class="card-body p-4">
                    <?= $searchConfig->renderForm(['template' => null, 'skip_form_action' => $skipFormAction]) ?>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// 詳細検索フォームの開閉状態をローカルストレージで管理
document.addEventListener('DOMContentLoaded', function() {
    const searchFormToggle = document.getElementById('searchFormToggle');
    const searchFormCollapse = document.getElementById('searchFormCollapse');
    const storageKey = 'searchFormState';
    
    if (searchFormToggle && searchFormCollapse) {
        // ローカルストレージから状態を読み込み
        const savedState = localStorage.getItem(storageKey);
        
        // 初期値はクローズ、保存された状態がopenの場合のみ開く
        if (savedState === 'open') {
            searchFormCollapse.classList.add('show');
            searchFormToggle.classList.remove('collapsed');
            searchFormToggle.setAttribute('aria-expanded', 'true');
        }
        
        // 開閉時に状態を保存
        searchFormCollapse.addEventListener('shown.bs.collapse', function() {
            localStorage.setItem(storageKey, 'open');
            // アイコンの回転
            const icon = searchFormToggle.querySelector('.bi-chevron-down');
            if (icon) {
                icon.style.transform = 'rotate(180deg)';
                icon.style.transition = 'transform 0.3s';
            }
        });
        
        searchFormCollapse.addEventListener('hidden.bs.collapse', function() {
            localStorage.setItem(storageKey, 'closed');
            // アイコンの回転を戻す
            const icon = searchFormToggle.querySelector('.bi-chevron-down');
            if (icon) {
                icon.style.transform = 'rotate(0deg)';
                icon.style.transition = 'transform 0.3s';
            }
        });
    }
});
</script>

<style>
/* 検索フォームトグルボタンのスタイル */
#searchFormToggle {
    color: var(--bs-body-color);
    transition: all 0.3s ease;
}

#searchFormToggle:hover {
    color: var(--bs-primary);
}

#searchFormToggle:focus {
    box-shadow: none;
}

#searchFormToggle .bi-chevron-down {
    transition: transform 0.3s ease;
}

#searchFormToggle:not(.collapsed) .bi-chevron-down {
    transform: rotate(180deg);
}

/* カードヘッダーのボーダー調整 */
.search-form-section .card-header {
    border-bottom: 1px solid var(--bs-border-color);
}

.search-form-section .collapse.show + .card-header,
.search-form-section .card-header:has(+ .collapse.show) {
    border-bottom: 1px solid var(--bs-border-color);
}
</style>

<!-- 検索結果 -->
<div class="search-results-wrapper py-4">
