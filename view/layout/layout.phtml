<?php
$escape = $this->plugin('escapeHtml');
$siteTitle = $site->title();
$this->htmlElement('html')->setAttribute('lang', $this->lang());
$this->headMeta()->setCharset('utf-8');
$this->headMeta()->appendName('viewport', 'width=device-width, initial-scale=1');
$this->headTitle($siteTitle)->setSeparator(' · ');
$this->headTitle()->append($this->setting('installation_title', 'Omeka S'));
$this->headLink()->prependStylesheet($this->assetUrl('css/iconfonts.css', 'Omeka'));
$this->headLink()->prependStylesheet('//fonts.googleapis.com/css?family=Open+Sans:400,400italic,600,600italic,700italic,700');

// Bootstrap 5 CSS
$this->headLink()->appendStylesheet('https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css', 'screen', ['integrity' => 'sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH', 'crossorigin' => 'anonymous']);
// Bootstrap Icons
$this->headLink()->appendStylesheet('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css');
// Search Form Override CSS

$this->headLink()->appendStylesheet($this->assetUrl('css/search-view-toggle.css'));
// Autocomplete styles
$this->headLink()->appendStylesheet($this->assetUrl('css/autocomplete.css'));
// Facet Range Slider styles
$this->headLink()->appendStylesheet($this->assetUrl('css/facet-range-slider.css'));
// Advanced Search Date Range styles
$this->headLink()->appendStylesheet($this->assetUrl('css/advanced-search-date-range.css'));
// Advanced Search Filters styles
$this->headLink()->appendStylesheet($this->assetUrl('css/advanced-search-filters.css'));
// Facet Badges styles for text wrapping
$this->headLink()->appendStylesheet($this->assetUrl('css/facet-badges.css'));

// Favicon設定 - テーマ設定から取得
$favicon = $this->themeSettingAssetUrl('favicon');
if ($favicon) {
    $this->headLink(['rel' => 'icon', 'href' => $favicon]);
    $this->headLink(['rel' => 'shortcut icon', 'href' => $favicon]);
}

$this->headScript()->prependFile($this->assetUrl('js/default.js'));
$this->headScript()->prependFile($this->assetUrl('js/global.js', 'Omeka'));
$this->headScript()->prependFile($this->assetUrl('vendor/jquery/jquery.min.js', 'Omeka'));

// Bootstrap 5 JS
$this->headScript()->appendFile('https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js', 'text/javascript', ['integrity' => 'sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz', 'crossorigin' => 'anonymous']);
$this->headScript()->appendFile($this->assetUrl('js/search-view-toggle.js'));
$this->headScript()->appendFile($this->assetUrl('js/facet-range-slider.js'));
$this->headScript()->appendFile($this->assetUrl('js/advanced-search-filters.js'));
$this->jsTranslate();
// Advanced Search Filtersで使用する翻訳文字列を追加
$this->jsTranslate('Enter filter keyword...');
$this->jsTranslate('Enter');
$this->jsTranslate('selected');
$this->jsTranslate('Select All');
$this->jsTranslate('Clear All');
$this->jsTranslate('Add Filter');
$this->jsTranslate('Remove filter');
$banner = $this->themeSettingAssetUrl('banner');
$bannerHeight = $this->themeSetting('banner_height');
$bannerHeightMobile = $this->themeSetting('banner_height_mobile');
$bannerPosition = ($this->themeSetting('banner_position')) ? str_replace('_','-', $this->themeSetting('banner_position')) : 'center';
$browseBodyTruncation = ($this->themeSetting('browse_body_truncation')) ? $this->themeSetting('browse_body_truncation') : 'fade';
$this->htmlElement('body')->appendAttribute('class', 'body-truncate-' . $browseBodyTruncation);
$this->trigger('view.layout'); 
$userBar = $this->userBar();

// サイト変数の確保
if (!isset($site)) {
    $site = $this->vars()->offsetGet('site');
}

// ホームページ判定（最小限版）
$isHomePage = false;

if ($site) {
    // ホームページ判定（最小限版）
    $homepage = $site->homepage();
    $homepageId = $homepage ? $homepage->id() : null;

    $currentPageId = null;
    $pageSlug = $this->params()->fromRoute('page-slug');
    if ($pageSlug) {
        try {
            $response = $this->api()->searchOne('site_pages', [
                'site_id' => $site->id(),
                'slug' => $pageSlug,
            ]);
            if ($response && $response->getContent()) {
                $currentPageId = $response->getContent()->id();
            }
        } catch (Exception $e) {
            // 無視
        }
    }

    $isHomePage = ($homepageId && $currentPageId && $homepageId == $currentPageId);
}

?>
<?php echo $this->doctype(); ?>
<?php echo $this->htmlElement('html'); ?>
    <head>
        <?php echo $this->headMeta(); ?>
        <?php echo $this->headTitle(); ?>
        <?php echo $this->headLink(); ?>
        <?php echo $this->headStyle(); ?>
        <?php echo $this->headScript(); ?>
    </head>

    <?php echo $this->htmlElement('body'); ?>
        <?php echo $userBar; ?>
        <?php // ヘッダー部分をpartialとして読み込み ?>
        <?php if ($site): ?>
            <?php echo $this->partial('common/header', ['site' => $site]); ?>
        <?php endif; ?>
        
        <?php if ($isHomePage): ?>
            <?php echo $this->partial('common/hero'); ?>
        <?php endif; ?>
        
        <?php if ($banner && !isset($page)): ?>
        <div class="banner">
            <img src="<?php echo $this->themeSettingAssetUrl('banner'); ?>" title="Banner">
        </div>
        <?php endif; ?>
        <div id="content" role="main">
            <?php echo $this->content; ?>
        </div>
        <?php // フッター部分をpartialとして読み込み ?>
        <?php if ($site): ?>
            <?php echo $this->partial('common/footer', ['site' => $site]); ?>
        <?php else: ?>
            <!-- フォールバックフッター -->
            <footer class="bg-light py-4 mt-5">
                <div class="container">
                    <p class="mb-0"><?php echo $this->translate('Powered by Omeka S'); ?></p>
                </div>
            </footer>
        <?php endif; ?>
    </body>
</html>
