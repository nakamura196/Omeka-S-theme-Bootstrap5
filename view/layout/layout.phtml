<?php
$escape = $this->plugin('escapeHtml');
$translate = $this->plugin('translate');
$siteTitle = $site->title();
$this->htmlElement('html')->setAttribute('lang', $this->lang());
$this->headMeta()->setCharset('utf-8');
$this->headMeta()->appendName('viewport', 'width=device-width, initial-scale=1');
$this->headTitle($siteTitle)->setSeparator(' · ');
$this->headTitle()->append($this->setting('installation_title', 'Omeka S'));
$this->headLink()->prependStylesheet($this->assetUrl('css/theme.css'));
$this->headLink()->prependStylesheet($this->assetUrl('vendor/fontawesome/css/all.min.css'));
$this->headLink()->prependStylesheet($this->assetUrl('vendor/bootstrap/bootstrap.min.css'));
$this->headScript()->prependFile($this->assetUrl('js/theme.js'));
$this->headScript()->prependFile($this->assetUrl('js/global.js', 'Omeka'));
$this->headScript()->prependFile($this->assetUrl('vendor/jquery/jquery.min.js', 'Omeka'));
$this->jsTranslate();

// Theme colors from the settings. Nothing is added while they keep the defaults of theme.css;
// hover shades and the rgb triplets Bootstrap needs are derived here.
$themeColors = [];
$shade = function ($hex, $factor) {
    return sprintf('#%02x%02x%02x', ...array_map(fn($c) => (int) round($c * $factor), sscanf($hex, '#%02x%02x%02x')));
};
$primary = strtolower((string) $this->themeSetting('primary_color'));
if (preg_match('/^#[0-9a-f]{6}$/', $primary) && $primary !== '#1e3a5f') {
    $rgb = implode(', ', sscanf($primary, '#%02x%02x%02x'));
    $themeColors[] = "--tb-primary: $primary; --tb-primary-hover: {$shade($primary, 0.75)};"
        . " --tb-link: $primary; --bs-primary-rgb: $rgb; --bs-link-color-rgb: $rgb;"
        . " --bs-link-hover-color-rgb: " . implode(', ', sscanf($shade($primary, 0.75), '#%02x%02x%02x')) . ";"
        . " --bs-focus-ring-color: rgba($rgb, 0.35);";
}
$accent = strtolower((string) $this->themeSetting('accent_color'));
if (preg_match('/^#[0-9a-f]{6}$/', $accent) && $accent !== '#a8322d') {
    $themeColors[] = "--tb-accent: $accent; --tb-accent-hover: {$shade($accent, 0.83)};";
}
if ($themeColors) {
    $this->headStyle()->appendStyle(':root { ' . implode(' ', $themeColors) . ' }');
}
$this->trigger('view.layout');
$userBar = $this->userBar();

// Same rule as Omeka's site index: the configured homepage, else the first linked page.
$homepage = $site->homepage() ?: current($site->linkedPages());
$isHomePage = $homepage && $this->params()->fromRoute('page-slug') === $homepage->slug();
// "hero_*" are the names used by Omeka-S-theme-Bootstrap5 2.x; read them when the 3.x names are empty.
$topImage = $this->themeSettingAssetUrl('top_image') ?: $this->themeSettingAssetUrl('hero_image');
$topUrl = $this->themeSetting('top_url') ?: $this->themeSetting('hero_button_url');
$topButtonText = $this->themeSetting('hero_button_text') ?: $translate('Browse');

// Open Graph tags (the card shown when a page is shared). Item and media pages pass their own
// values through common/og-meta; other pages use the site's title, summary and top image.
$absolute = fn($url) => $url && $url[0] === '/' ? $this->serverUrl($url) : $url;
$og = [
    'og:site_name' => $siteTitle,
    'og:type' => $this->ogType ?: 'website',
    'og:title' => $this->ogTitle ?: $this->headTitle()->renderTitle(),
    'og:description' => $this->ogDescription ?: strip_tags((string) $site->summary()),
    'og:url' => $this->serverUrl(true),
    'og:image' => $absolute($this->ogImage ?: $topImage),
];
$footerContent = $this->themeSetting('footer');
?>
<?php echo $this->doctype(); ?>
<?php echo $this->htmlElement('html'); ?>
<head>
    <?php echo $this->headMeta(); ?>
    <?php foreach (array_filter($og) as $property => $content): ?>
    <meta property="<?php echo $property; ?>" content="<?php echo $escape($content); ?>">
    <?php endforeach; ?>
    <meta name="twitter:card" content="<?php echo $og['og:image'] ? 'summary_large_image' : 'summary'; ?>">
    <?php echo $this->headTitle(); ?>
    <?php echo $this->headLink(); ?>
    <?php echo $this->headStyle(); ?>
    <?php echo $this->headScript(); ?>
</head>

<?php echo $this->htmlElement('body'); ?>
<a class="visually-hidden-focusable" id="skipnav" href="#content"><?php echo $translate('Skip to main content'); ?></a>
<?php echo $userBar; ?>
<?php echo $this->partial('common/header'); ?>

<?php if ($isHomePage && $topImage): ?>
<div class="top-hero" style="background-image: url('<?php echo $escape($topImage); ?>');">
    <div class="top-hero-overlay">
        <div class="container">
            <div class="row py-5 text-white text-center">
                <div class="col-xl-9 mx-auto my-5">
                    <?php if ($siteSubTitle = $this->themeSetting('site_sub_title')): ?>
                    <p class="top-hero-sub mb-3"><?php echo $siteSubTitle; ?></p>
                    <?php endif; ?>
                    <h1><?php echo $escape($siteTitle); ?></h1>
                    <?php if ($siteSummary = $site->summary()): ?>
                    <p class="top-hero-summary mt-3"><?php echo $siteSummary; ?></p>
                    <?php endif; ?>
                    <?php if ($topUrl): ?>
                    <a href="<?php echo $escape(trim(strip_tags($topUrl))); ?>" class="mt-4 btn btn-accent">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> <?php echo $escape($topButtonText); ?>
                    </a>
                    <?php endif; ?>
                </div>
            </div>
        </div>
    </div>
</div>
<?php endif; ?>

<div id="content" role="main" tabindex="-1">
    <?php echo $this->messages(); ?>
    <?php echo $this->content; ?>
</div>

<footer class="site-footer">
    <div class="container-xxl">
        <div class="footer-main">
            <div class="footer-about">
                <a class="footer-site-title" href="<?php echo $escape($site->url()); ?>"><?php echo $escape($siteTitle); ?></a>
                <?php if ($footerContent && trim(strip_tags($footerContent)) !== 'Powered by Omeka S'): ?>
                <div class="footer-content"><?php echo $footerContent; ?></div>
                <?php endif; ?>
            </div>
            <nav class="footer-nav" aria-label="<?php echo $escape($translate('Footer navigation')); ?>">
                <?php echo $site->publicNav()->menu()->renderMenu(null, ['maxDepth' => 0, 'ulClass' => 'footer-links']); ?>
            </nav>
        </div>
        <p class="footer-bottom"><?php echo $translate('Powered by Omeka S'); ?></p>
    </div>
</footer>

<div class="theme-toast" role="status" aria-live="polite" hidden></div>

<button type="button" class="btn btn-primary" id="btn-back-to-top" hidden aria-label="<?php echo $escape($translate('Back to top')); ?>">
    <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
</button>
</body>
</html>
